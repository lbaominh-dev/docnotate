<dialog class="workspace-modal" data-workspace-modal-target="modal" data-action="click->workspace-modal#backdropClick">
  <div class="workspace-modal__header">
    <h3 class="workspace-modal__title">Workspace & MCP Settings</h3>
    <button type="button" class="icon-button" data-action="click->workspace-modal#close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <div class="workspace-modal__body">
    <%= render "application/workspace_list" %>

    <hr style="border: none; border-top: 1px solid rgba(25, 29, 38, 0.1); margin: 8px 0;">

    <%= render "application/mcp_settings" %>

    <hr style="border: none; border-top: 1px solid rgba(25, 29, 38, 0.1); margin: 8px 0;">

    <div>
      <%= form_with url: workspace_path, method: :patch, class: "home__form" do |f| %>
        <span class="workspace-modal__label">Rename Workspace:</span>
        <div style="display: flex; gap: 8px;">
          <%= f.text_field "user[name]", value: current_user.name, class: "workspace-modal__input", style: "font-family: inherit;" %>
          <%= f.submit "Save", class: "button" %>
        </div>
      <% end %>
    </div>
  </div>
</dialog>
